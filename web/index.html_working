<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>The Rajas Photo And Video Uploader</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <style>
    :root { color-scheme: light dark; }
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
    h1 { font-size: 1.6rem; margin-bottom: .25rem; }
    .muted { color: #666; }
    .card { border: 1px solid #ddd; border-radius: 14px; padding: 1rem 1.2rem; box-shadow: 0 2px 10px rgba(0,0,0,.05); margin-bottom: 1rem; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; align-items: center; }
    .row  { display:flex; gap:.75rem; align-items:center; flex-wrap:wrap; }
    button { padding: .6rem 1rem; border-radius: 999px; border: 1px solid #ccc; cursor: pointer; }
    select, input[type="text"] { width: 100%; padding: .5rem; border: 1px solid #ccc; border-radius: .5rem; }
    progress { width: 100%; height: 12px; }
    code { background: #f6f6f6; padding: .1rem .4rem; border-radius: 6px; }
    .fade-out { opacity: 0; transition: opacity .5s ease; }
  </style>
</head>
<body>
  <h1>Upload files to AWS</h1>
  <p class="muted">Sign in with Cognito, choose a bucket and optional folder, then upload multiple files at once.</p>

  <div class="row" style="margin-bottom:1rem;">
    Status: <strong id="authState" class="muted">Checking…</strong>
    <button id="logoutBtn" style="display:none;">Sign out</button>
    <button id="loginBtn"  style="display:none;">Sign in</button>
    <span class="muted" id="whoami"></span>
  </div>

  <div class="card">
    <div class="grid">
      <label>Bucket
        <select id="bucket"><option>Loading…</option></select>
        <small class="muted">Loaded from <code>GET /buckets</code></small>
      </label>
      <label>Folder (prefix)
        <input id="folder" type="text" placeholder="e.g. uploads/wedding/2025" />
        <small class="muted">Optional; no leading slash</small>
      </label>
    </div>
  </div>

  <div class="card">
    <div class="row" style="margin-bottom:.5rem;">
      <input id="files" type="file" multiple />
      <button id="uploadBtn">Upload selected</button>
      <button id="clearBtn" type="button">Clear finished</button>
    </div>

    <div id="overallStatus" class="muted"></div>

    <!-- Live counters -->
    <div id="counters" class="muted" style="margin:.25rem 0 .5rem 0;">
      Total: <span id="cntTotal">0</span> •
      In-flight: <span id="cntInFlight">0</span> •
      Completed: <span id="cntCompleted">0</span> •
      Failed: <span id="cntFailed">0</span> •
      Remaining: <span id="cntRemaining">0</span>
    </div>

    <!-- Per-file rows appear here, bounded display -->
    <div id="queue" style="display:grid; gap:.5rem;"></div>
  </div>

<script>
  // ================== CONFIG — replace these ==================
  const API_BASE         = "https://hea4g3ytp6.execute-api.us-east-1.amazonaws.com";              // e.g., https://abc123.execute-api.us-east-1.amazonaws.com
  const USER_POOL_DOMAIN = "https://rajas-uploader.auth.us-east-1.amazoncognito.com";    // e.g., https://yourprefix.auth.us-east-1.amazoncognito.com
  const CLIENT_ID        = "6i0p88m6vgvppc2bj5lvde1tjk";
  const APP_ORIGIN       = window.location.origin;                   // must be in Cognito Callback & Sign-out URLs
  // ============================================================

  // ---- sanity check config ----
  function validateConfig() {
    const errs = [];
    if (!API_BASE || API_BASE.startsWith("REPLACE_WITH")) errs.push("API_BASE not set");
    if (!USER_POOL_DOMAIN || USER_POOL_DOMAIN.startsWith("REPLACE_WITH")) errs.push("USER_POOL_DOMAIN not set");
    if (!CLIENT_ID || CLIENT_ID.startsWith("REPLACE_WITH")) errs.push("CLIENT_ID not set");
    if (!/^https:\/\/.*\.auth\.[-a-z0-9]+\.amazoncognito\.com$/i.test(USER_POOL_DOMAIN)) errs.push("USER_POOL_DOMAIN format looks wrong");
    if (location.protocol === "http:" && location.hostname !== "localhost") errs.push("Use HTTPS (Cognito only allows http://localhost or HTTPS)");
    if (errs.length) { alert("Config issue:\n- " + errs.join("\n- ")); return false; }
    return true;
  }

  // ---- auth helpers ----
  function hostedBase(){ return USER_POOL_DOMAIN.replace(/\/(login|oauth2)\/?$/i, ""); }
  function getIdToken(){ return localStorage.getItem("id_token"); }
  function setIdToken(v){ localStorage.setItem("id_token", v); }
  function clearIdToken(){ localStorage.removeItem("id_token"); }

  function buildLoginUrl(){
    const u = new URL(hostedBase() + "/login");
    u.searchParams.set("client_id", CLIENT_ID);
    u.searchParams.set("response_type", "token");            // implicit quickstart
    u.searchParams.set("scope", "openid email profile");
    u.searchParams.set("redirect_uri", APP_ORIGIN);          // must match a Callback URL
    return u.toString();
  }
  function buildLogoutUrl(){
    const returnTo = APP_ORIGIN + "/?signedout=1";           // avoid 404s on static servers
    const u = new URL(hostedBase() + "/logout");
    u.searchParams.set("client_id", CLIENT_ID);
    u.searchParams.set("logout_uri", returnTo);
    u.searchParams.set("redirect_uri", returnTo);            // harmless; helps some setups
    return u.toString();
  }

  function manualLogin(){ if (!validateConfig()) return; window.location.assign(buildLoginUrl()); }
  function logout()     { clearIdToken(); window.location.assign(buildLogoutUrl()); }

  // ---- show who is logged in (optional) ----
  function decodeJwtPayload(jwt){
    try {
      const base64 = jwt.split(".")[1].replace(/-/g,"+").replace(/_/g,"/");
      const json = decodeURIComponent(atob(base64).split("").map(c=>"%" + ("00"+c.charCodeAt(0).toString(16)).slice(-2)).join(""));
      return JSON.parse(json);
    } catch { return null; }
  }
  function renderAuthState(){
    const t = getIdToken();
    const authEl = document.getElementById("authState");
    const whoEl  = document.getElementById("whoami");
    const logoutBtn = document.getElementById("logoutBtn");
    const loginBtn  = document.getElementById("loginBtn");
    if (t){
      authEl.textContent = "Signed in";
      const p = decodeJwtPayload(t);
      whoEl.textContent = p ? ` • ${p.email || p.username || p["cognito:username"] || ""}` : "";
      logoutBtn.style.display = "inline-block";
      loginBtn.style.display  = "none";
    } else {
      authEl.textContent = "Signed out";
      whoEl.textContent = "";
      logoutBtn.style.display = "none";
      loginBtn.style.display  = "inline-block";
    }
  }

  // ---- buckets API ----
  async function fetchBuckets(){
    const token = getIdToken();
    const r = await fetch(`${API_BASE}/buckets`, {
      method: "GET",
      headers: { "Authorization": `Bearer ${token}` }
    });
    if (!r.ok) {
      const txt = await r.text().catch(()=>"(no body)");
      console.error("GET /buckets failed:", r.status, txt);
      throw new Error(`Buckets request failed: ${r.status}`);
    }
    const { buckets } = await r.json();
    return buckets || [];
  }
  function fillBucketSelect(names){
    const sel = document.getElementById("bucket");
    if (!names.length){ sel.innerHTML = `<option value="" disabled selected>(none available)</option>`; return; }
    sel.innerHTML = names.map(n=>`<option value="${n}">${n}</option>`).join("");
  }

  // ---- boot: handle Cognito return, signed-out bounce, auto-login, then load buckets ----
  (async function boot(){
    if (!validateConfig()) return;

    if (window.location.hash){ // return from Hosted UI
      const hash = new URLSearchParams(window.location.hash.substring(1));
      const idToken = hash.get("id_token");
      const err = hash.get("error_description") || hash.get("error");
      if (idToken) setIdToken(idToken);
      history.replaceState({}, document.title, window.location.pathname); // clean hash
      if (err) { console.error("Hosted UI error:", err); alert("Login error: " + err); }
    }

    const params = new URLSearchParams(window.location.search);
    const noauto = params.get("noauto") === "1";
    const signedOut = params.get("signedout") === "1";

    if (!getIdToken() && signedOut && !noauto) {
      window.location.replace(buildLoginUrl());
      return;
    }
    if (!getIdToken() && !noauto) {
      window.location.assign(buildLoginUrl());
      return;
    }

    renderAuthState();
    document.getElementById("logoutBtn").onclick = logout;
    document.getElementById("loginBtn").onclick  = manualLogin;

    try {
      fillBucketSelect(await fetchBuckets());
    } catch (e){
      console.error(e);
      alert("Could not load buckets. Check API route, JWT authorizer, IAM, and Lambda logs.");
      fillBucketSelect([]);
    }
  })();

  // ========= Multi-file uploader with ephemeral rows & counters =========
  const $files     = document.getElementById("files");
  const $btn       = document.getElementById("uploadBtn");
  const $clear     = document.getElementById("clearBtn");
  const $queue     = document.getElementById("queue");
  const $overall   = document.getElementById("overallStatus");

  // counters
  const $cntTotal     = document.getElementById("cntTotal");
  const $cntInFlight  = document.getElementById("cntInFlight");
  const $cntCompleted = document.getElementById("cntCompleted");
  const $cntFailed    = document.getElementById("cntFailed");
  const $cntRemaining = document.getElementById("cntRemaining");

  // behavior knobs
  const CONCURRENCY       = 3;
  const AUTO_REMOVE_MS    = 3000; // remove each finished row after 3s
  const MAX_VISIBLE_ROWS  = 50;   // keep the list tidy

  function updateCounters({total, inFlight, completed, failed}) {
    $cntTotal.textContent     = total;
    $cntInFlight.textContent  = inFlight;
    $cntCompleted.textContent = completed; // successes ✅
    $cntFailed.textContent    = failed;    // failures ❌
    $cntRemaining.textContent = Math.max(0, total - (completed + failed + inFlight));
  }

  function makeRow(file) {
    const row = document.createElement("div");
    row.className = "row-item";
    row.style.border = "1px solid #ddd";
    row.style.borderRadius = "10px";
    row.style.padding = ".5rem .75rem";
    row.innerHTML = `
      <div style="display:flex;justify-content:space-between;gap:.75rem;align-items:center;">
        <div style="min-width:0;">
          <div style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${file.name}</div>
          <div class="muted" style="font-size:.9em">${(file.type || "application/octet-stream")} • ${(file.size/1024/1024).toFixed(2)} MB</div>
        </div>
        <div class="status" style="white-space:nowrap;">Queued</div>
      </div>
      <progress max="100" value="0" style="width:100%;height:12px;margin-top:.4rem;"></progress>
      <div class="result" style="margin-top:.25rem;font-family:ui-monospace, SFMono-Regular, Menlo, monospace;"></div>
    `;
    return row;
  }

  function removeRow(row, delayMs = AUTO_REMOVE_MS) {
    if (!row.isConnected) return;
    setTimeout(() => {
      row.classList.add("fade-out");
      setTimeout(() => row.remove(), 500); // match CSS transition
    }, delayMs);
  }

  function boundVisibleRows() {
    const rows = $queue.querySelectorAll(".row-item");
    if (rows.length <= MAX_VISIBLE_ROWS) return;
    const extra = rows.length - MAX_VISIBLE_ROWS;
    let removed = 0;
    for (const r of rows) {
      const status = r.querySelector(".status")?.textContent || "";
      if (/^Done|^Failed|^Presign failed|^Network error/.test(status)) {
        r.remove();
        removed++;
        if (removed >= extra) break;
      }
    }
  }

  async function uploadOne(file, bucket, folder, row, token) {
    const status = row.querySelector(".status");
    const progress = row.querySelector("progress");
    const result = row.querySelector(".result");

    status.textContent = "Authorizing…";
    const presignResp = await fetch(`${API_BASE}/presign`, {
      method: "POST",
      headers: { "Content-Type": "application/json", "Authorization": `Bearer ${token}` },
      body: JSON.stringify({
        filename: file.name,
        contentType: file.type || "application/octet-stream",
        bucket,
        folder
      })
    });

    if (!presignResp.ok) {
      const body = await presignResp.text().catch(()=>"(no body)");
      status.textContent = "Presign failed";
      result.textContent = body;
      removeRow(row);
      throw new Error(`Presign failed: ${presignResp.status} ${body}`);
    }

    const { url, fields, key, bucket: bkt } = await presignResp.json();

    status.textContent = "Uploading…";
    const formData = new FormData();
    Object.entries(fields).forEach(([k, v]) => formData.append(k, v));
    formData.append("file", file); // don't append "key" again

    const xhr = new XMLHttpRequest();
    const done = new Promise((resolve, reject) => {
      xhr.upload.onprogress = (e) => {
        if (e.lengthComputable) progress.value = Math.round((e.loaded / e.total) * 100);
      };
      xhr.onload = () => {
        if (xhr.status === 204) {
          status.textContent = "Done ✅";
          result.textContent = `s3://${bkt}/${key}`;
          removeRow(row);
          resolve();
        } else {
          status.textContent = `Failed ${xhr.status}`;
          result.textContent = xhr.responseText || "";
          removeRow(row);
          reject(new Error(`S3 upload failed ${xhr.status}`));
        }
      };
      xhr.onerror = () => {
        status.textContent = "Network error";
        removeRow(row);
        reject(new Error("Network error"));
      };
    });

    xhr.open("POST", url, true);
    xhr.send(formData);
    return done;
  }

  async function uploadMany(files, bucket, folder, token, concurrency = CONCURRENCY) {
    const queue = Array.from(files);
    let inFlight = 0, completed = 0, failed = 0;
    const total = queue.length;

    $overall.textContent = `Starting ${total} upload(s)…`;
    updateCounters({ total, inFlight, completed, failed });

    return new Promise((resolve) => {
      const next = () => {
        while (inFlight < concurrency && queue.length) {
          const file = queue.shift();
          const row = makeRow(file);
          $queue.appendChild(row);
          boundVisibleRows();
          inFlight++;
          updateCounters({ total, inFlight, completed, failed });

          uploadOne(file, bucket, folder, row, token)
            .then(() => completed++)
            .catch(() => failed++)
            .finally(() => {
              inFlight--;
              updateCounters({ total, inFlight, completed, failed });

              const doneCount = completed + failed;
              $overall.textContent = doneCount === total
                ? (failed ? `All done. ${completed} succeeded, ${failed} failed.` : `All done. ${completed} succeeded.`)
                : `Completed: ${doneCount}/${total}` + (failed ? ` • Failed: ${failed}` : "");

              if (doneCount === total) resolve();
              else next();
            });
        }
      };
      next();
    });
  }

  document.getElementById("uploadBtn").onclick = async () => {
    const token = getIdToken();
    if (!token) return alert("Please sign in first.");

    const list = document.getElementById("files").files;
    if (!list || list.length === 0) return alert("Choose one or more files first.");

    const bucket = document.getElementById("bucket").value;
    if (!bucket) return alert("Select a bucket.");

    const folder = (document.getElementById("folder").value || "").trim();

    // reset UI
    $overall.textContent = "Preparing…";
    updateCounters({ total: list.length, inFlight: 0, completed: 0, failed: 0 });

    try {
      await uploadMany(list, bucket, folder, token);
    } catch (e) {
      console.error(e);
      $overall.textContent = "Some uploads failed. See above.";
    }
  };

  // Clear finished rows immediately
  document.getElementById("clearBtn").onclick = () => {
    for (const r of $queue.querySelectorAll(".row-item")) {
      const status = r.querySelector(".status")?.textContent || "";
      if (/^Done|^Failed|^Presign failed|^Network error/.test(status)) r.remove();
    }
  };
</script>
</body>
</html>
